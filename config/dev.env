# dev environment. Names and policies only; no secrets, IDs or personal details.
# Endpoints are written by infra/env.sh to .env (gitignored).
FBD_ENV=dev
RG=rg-failed-bank-docai-dev
# centralus: where the Azure SQL free offer is available on this subscription; DI goes to eastus (diLocation)
LOCATION=centralus
# Power Platform CLI profile (pac auth create --name fbd-dev ...) and solution packaging
PAC_PROFILE=fbd-dev
SOLUTION_PACKAGE=Unmanaged
